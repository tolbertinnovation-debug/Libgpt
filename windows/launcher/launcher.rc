      VALUE "ProductName", "Grandpa AI app"
      VALUE "ProductVersion", "1.0.0.0"
      VALUE "LegalCopyright", "Made with Grandpa AI"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
