{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": null,
  "outputDirectory": "public",

  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],

  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ]
}
