{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        }
      ]
    }
  ],
  "framework": "nitro",
  "git": {
    "deploymentEnabled": {
      "codex/governance-budget-fixes": false,
      "codex/phase2-audit-tasks": false,
      "codex/phase2-request-history": false,
      "codex/phase2-execution-stage1": false,
      "codex/phase2-stage2-eligibility": false
    }
  }
}
