# ---- Grandpa AI configuration -------------------------------------------
# Your OpenAI (ChatGPT) API key. Get one at https://platform.openai.com/api-keys
# Never commit the real key — copy this file to `.env` and fill it in there.
OPENAI_API_KEY=sk-your-key-here

# Model used for chat replies. Any chat-completions model your account can use.
OPENAI_MODEL=gpt-4o-mini

# Cheaper model used only to auto-name conversations in the sidebar.
OPENAI_TITLE_MODEL=gpt-4o-mini

# Optional: point at a compatible gateway / Azure-style proxy instead.
OPENAI_BASE_URL=https://api.openai.com/v1

# Port the server listens on.
PORT=3000

# Requests allowed per IP per minute (simple abuse guard).
RATE_LIMIT_PER_MINUTE=30
