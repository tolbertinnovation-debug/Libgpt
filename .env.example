# ---- Grandpa AI configuration -------------------------------------------
# Your OpenAI (ChatGPT) API key. Get one at https://platform.openai.com/api-keys
# Never commit the real key — copy this file to `.env` and fill it in there.
OPENAI_API_KEY=sk-your-key-here

# Normally you do not need to name a model at all. The server asks your account
# which models it has and picks one per task: the cheapest for naming a
# conversation, the best available for a folktale. These two are only the
# last resort, used when that listing cannot be read.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TITLE_MODEL=gpt-4o-mini

# Optional: pin the automatic choice, if you know better than the heuristic.
# Leave blank to let the server choose. A model your account does not have is
# ignored rather than breaking every request.
#   fast     — naming conversations, quiz questions, low-data mode
#   balanced — ordinary conversation, recipes, naming traditions
#   deep     — folktales and the storytelling persona
MODEL_FAST=
MODEL_BALANCED=
MODEL_DEEP=

# Optional: point at a compatible gateway / Azure-style proxy instead.
OPENAI_BASE_URL=https://api.openai.com/v1

# Port the server listens on.
PORT=3000

# Requests allowed per IP per minute (simple abuse guard).
RATE_LIMIT_PER_MINUTE=30

# ---- Pictures (the Cultural Album) --------------------------------------
# OFF by default, and deliberately so: a picture costs cents, where a text
# answer costs hundredths of a cent. Set to `true` only when you mean it.
ENABLE_IMAGES=false

# Image model. `dall-e-3` works on any account. `gpt-image-1` is newer and
# better but some accounts must verify with OpenAI before they can use it.
OPENAI_IMAGE_MODEL=dall-e-3

# A hard ceiling on pictures per hour across the whole deployment, so a
# public address cannot empty your account overnight.
IMAGES_PER_HOUR=20

# Optional. Leave blank and anyone who can reach the site can chat — fine on
# your own computer, risky on a public address, because every message is
# charged to the API key above. Set any word or phrase here and visitors must
# enter it before they can chat.
ACCESS_CODE=
