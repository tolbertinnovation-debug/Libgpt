# ---- Grandpa AI configuration -------------------------------------------
# Your OpenAI (ChatGPT) API key. Get one at https://platform.openai.com/api-keys
# Never commit the real key — copy this file to `.env` and fill it in there.
OPENAI_API_KEY=sk-your-key-here

# Normally you do not need to name a model at all. The server asks your account
# which models it has and picks one per task: the cheapest for naming a
# conversation, the best available for a folktale. These two are only the
# last resort, used when that listing cannot be read.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TITLE_MODEL=gpt-4o-mini

# Optional: pin the automatic choice, if you know better than the heuristic.
# Leave blank to let the server choose. A model your account does not have is
# ignored rather than breaking every request.
#   fast     — naming conversations, quiz questions, low-data mode
#   balanced — ordinary conversation, recipes, naming traditions
#   deep     — folktales and the storytelling persona
MODEL_FAST=
MODEL_BALANCED=
MODEL_DEEP=

# Optional: point at a compatible gateway / Azure-style proxy instead.
OPENAI_BASE_URL=https://api.openai.com/v1

# Port the server listens on.
PORT=3000

# Requests allowed per IP per minute (simple abuse guard).
RATE_LIMIT_PER_MINUTE=30


# ---- Looking ---------------------------------------------------------------
# Letting somebody photograph a thing and ask about it.
#
# This app offers to work through a child's homework and to say what is wrong
# with a crop. Both are things a person is LOOKING at, and putting that into
# words is the hard part. The picture is shrunk on the phone before it is sent
# — a 6.7 MB photo goes out as about 190 KB — so it costs a fraction of what a
# camera makes, but it is not free, hence the ceiling.
#
# The camera button only appears where a model on this key can actually look.
ENABLE_VISION=true
PHOTOS_PER_HOUR=60

# ---- Hearing --------------------------------------------------------------
# Turning a recording of somebody talking into words.
#
# The browser's own speech recognition is a Google service wearing a web
# standard's name: missing on Firefox, thin on iOS, and erratic on the Android
# phones that are most of this audience. Sending the recording to the server
# instead works the same on every browser, and costs about half a US cent a
# minute. On by default — listening that does not work is the same as none.
ENABLE_DICTATION=true

# gpt-4o-mini-transcribe is the cheap accurate one. An account that has not got
# it falls back to whisper-1 by itself, which every account has.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# A ceiling across the whole deployment, like the voice has, so a public
# address cannot empty the account. The default is an hour of listening.
DICTATION_SECONDS_PER_HOUR=3600

# ---- Grandpa's own voice --------------------------------------------------
# The phone's built-in text-to-speech is free but sounds like a machine, and on
# most Android handsets it is a young woman's machine — which is not what an
# app called Grandpa AI can sound like. With this on, the answer is spoken by a
# real voice from OpenAI, one per elder, told how an old man on his porch
# talks. It costs roughly a US cent for four or five answers.
#
# Low-data mode turns it off by itself: speech is tens of kilobytes.
ENABLE_REAL_VOICE=true

# Natural OpenAI speech with Cedar (default) or Marin in Voice settings.
# Old tts-1 / tts-1-hd settings automatically upgrade to gpt-4o-mini-tts.
OPENAI_VOICE_MODEL=gpt-4o-mini-tts

# A ceiling across the whole deployment — roughly 150 spoken answers an hour.
VOICE_CHARS_PER_HOUR=60000

# ---- Live Talk (two-way voice, like ChatGPT voice mode) -------------------
# Uses OpenAI's Realtime API over WebRTC. Live audio costs much more than text,
# so each conversation is capped in minutes and the deployment in conversations
# per hour. On a serverless host it also requires ACCESS_CODE. When it is off or
# fails, the Talk screen falls back to record, transcribe and speak.
# On by default (owner-approved). Set false to switch it off. Each session is
# reserved at its worst-case cost from the Live Talk daily limit because its real
# usage is reported only to the browser (see docs/budget-controls.md).
ENABLE_LIVE_TALK=true
# Leave empty to use the cheapest realtime model on the account.
OPENAI_REALTIME_MODEL=
LIVE_TALK_MINUTES=2
LIVE_TALK_SESSIONS_PER_HOUR=20

# ---- Spending controls (every paid feature) -------------------------------
# One persistent ledger meters chat, research, documents, the Library,
# pictures, voice, Live Talk and Build. The approved policy caps the day at
# $0.50 in total ($0.20 for Build) with 2 calls at a time; these values only
# seed a new ledger and can never raise it above that policy. Change limits
# later through the operator route (see docs/budget-controls.md).
RITUAL_DAILY_USD=0.5
RITUAL_CONCURRENCY=2
# Operator credential for /api/admin/budget, pause/resume and the audit trail.
# At least 32 characters. Never the visitor access code.
RITUAL_ADMIN_TOKEN=
# Postgres for the ledger (required on Vercel; Vercel's integration sets one).
# RITUAL_DATABASE_URL=
# Models the app and Build may use. Each needs a verified price in
# server/agent-costs.js. Defaults: gpt-5.4-mini,gpt-5.4-nano,gpt-4.1-mini,gpt-4o-mini
# APP_MODELS=
# RITUAL_AGENT_MODELS=

# ---- Pictures (the Cultural Album) --------------------------------------
# OFF by default, and deliberately so: a picture costs cents, where a text
# answer costs hundredths of a cent. Set to `true` only when you mean it.
ENABLE_IMAGES=false

# Image model. `dall-e-3` works on any account. `gpt-image-1` is newer and
# better but some accounts must verify with OpenAI before they can use it.
OPENAI_IMAGE_MODEL=dall-e-3

# A hard ceiling on pictures per hour across the whole deployment, so a
# public address cannot empty your account overnight.
IMAGES_PER_HOUR=20

# Optional. Leave blank and anyone who can reach the site can chat — fine on
# your own computer, risky on a public address, because every message is
# charged to the API key above. Set any word or phrase here and visitors must
# enter it before they can chat.
ACCESS_CODE=

# Making everybody enter the code again, WITHOUT changing the code.
#
# A code is remembered in each browser until it stops matching, which is what
# anybody wants — nobody should retype it every morning. But then the only way
# to make people enter it again is to change it, and there are reasons to want
# one without the other: a phone was lost, the code was passed further than
# intended, or the group has changed and it is time everyone said the word
# again.
#
# Change this to anything — a date, a number — and every browser is asked for
# the code once more, the same code as before. Leaving it blank is the ordinary
# state and turns nobody out. An ordinary redeploy changes nothing.
ACCESS_CODE_ROUND=

# ---- Live news and the web ------------------------------------------------
# Without this, Grandpa has no idea what happened this morning — and says so,
# which is the honest answer but not a useful one. With it on, a question that
# is actually about now ("what is the news today", "the rate for the dollar",
# "who won last night") is sent to a search-capable model on this same account,
# which goes and reads the web before answering. Same key, same bill.
#
# Everything else still goes to the ordinary model: a search costs more, and
# how to plant rice has not changed since the model was trained. Turns that did
# not search keep the old rule — he says he has not heard the news.
#
# If the account has no search-capable model, this quietly stays off rather
# than promising something the key cannot do.
ENABLE_LIVE_NEWS=true

# Which model does the reading. Left empty, the server picks the best-value one
# the account actually has — a mini first, because the searching is what costs
# and summarising three news reports is not hard work.
#
# Not gpt-4o-search-preview: those models were retired, and a key that still
# sees them listed gets "has been deprecated" when it tries to use one. The
# reading is done with the web-search tool on an ordinary model instead.
OPENAI_SEARCH_MODEL=

# Stop before Vercel's 300-second function limit and offer continuation.
# Lower this when another host has a shorter request limit.
TURN_DEADLINE_MS=270000


# ---- Meta Llama backup (optional) -----------------------------------------
# When OpenAI cannot answer a chat message (an outage, a quota, a refused key)
# or today's Chat limit is reached, Meta's Llama answers that message instead.
# Get a key at llama.developer.meta.com. It stays on the server. The backup
# also needs its own daily amount on Owner Controls ($0 keeps it off).
LLAMA_API_KEY=
# LLAMA_BASE_URL=https://api.llama.com/compat/v1
# LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
